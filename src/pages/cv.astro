---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import cv from '../../company/cv.json';
import type { Cv } from '../types/cv';

const data = cv as Cv;
const lang: 'it' | 'en' = 'it';
const L = (f: { it: string; en: string }) => f[lang];
---

<Layout title="CV — Mario Leone | AI Engineer & Consulente Software | Leone Consulting" description={`Curriculum di ${data.name}: ${L(data.role)}. Progetti, competenze e esperienza in AI engineering, data pipeline e sviluppo software.`}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="pt-32 pb-20 px-6 bg-gradient-to-br from-primary-50 to-white">
      <div class="container mx-auto">
        <div class="max-w-4xl mx-auto">
          <p class="text-sm font-semibold text-primary-600 uppercase tracking-wider mb-2">
            Curriculum &middot; aggiornato {data.updated}
          </p>
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-3">{data.name}</h1>
          <p class="text-xl text-gray-600 mb-6">{L(data.role)}</p>
          <p class="text-lg text-gray-600 leading-relaxed mb-8 max-w-3xl">{L(data.summary)}</p>
          <div class="flex flex-wrap gap-4 text-sm">
            <a href="/cv.pdf" download class="px-5 py-2.5 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors font-medium">⬇ Scarica PDF</a>
            <a href={`mailto:${data.contacts.email}`} class="px-5 py-2.5 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors font-medium">{data.contacts.email}</a>
            <a href={`tel:${data.contacts.phone.replace(/\s/g, '')}`} class="px-5 py-2.5 border-2 border-primary-600 text-primary-600 rounded-lg hover:bg-primary-600 hover:text-white transition-all font-medium">{data.contacts.phone}</a>
            {data.contacts.github && <a href={data.contacts.github} target="_blank" rel="noreferrer" class="px-5 py-2.5 border-2 border-gray-300 text-gray-700 rounded-lg hover:border-gray-500 transition-all font-medium">GitHub ↗</a>}
          </div>
          <div class="grid grid-cols-3 gap-6 mt-12 max-w-xl">
            {data.stats.map((s) => (
              <div class="text-center">
                <div class="text-3xl font-bold text-primary-600">{s.value}</div>
                <div class="text-sm text-gray-500 mt-1">{L(s.label)}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section class="py-20 px-6">
      <div class="container mx-auto">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-gray-900 mb-10">{lang === 'it' ? 'Competenze' : 'Skills'}</h2>
          <div class="grid md:grid-cols-2 gap-6">
            {data.skills.map((area) => (
              <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
                <h3 class="font-bold text-gray-900 mb-4">{L(area.area)}</h3>
                <ul class="space-y-2 text-gray-600 text-sm">
                  {area.items.map((item) => <li>&bull; {item}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section class="py-20 px-6 bg-gray-50">
      <div class="container mx-auto">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-gray-900 mb-10">{lang === 'it' ? 'Esperienza' : 'Experience'}</h2>
          <div class="space-y-8">
            {data.experience.map((exp) => (
              <div class="bg-white p-8 rounded-xl shadow-lg border-l-4 border-primary-600">
                <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
                  <h3 class="text-xl font-bold text-gray-900">{L(exp.role)}</h3>
                  <span class="text-sm font-medium text-primary-600">{exp.period}</span>
                </div>
                <p class="text-gray-500 font-medium mb-4">
                  {exp.url ? <a href={exp.url} target={exp.url.startsWith('http') ? '_blank' : undefined} rel="noreferrer" class="hover:text-primary-600 transition-colors">{exp.org} ↗</a> : exp.org}
                </p>
                <ul class="space-y-2 text-gray-600">
                  {exp.highlights.map((h) => <li class="flex gap-2"><span class="text-primary-600 font-bold">&bull;</span><span>{L(h)}</span></li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section class="py-20 px-6">
      <div class="container mx-auto">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-gray-900 mb-10">{lang === 'it' ? 'Progetti selezionati' : 'Selected projects'}</h2>
          <div class="grid md:grid-cols-2 gap-6">
            {data.projects.map((p) => (
              <div class="bg-primary-50 p-6 rounded-lg border border-primary-100">
                <h3 class="font-bold text-gray-900 mb-2">
                  {p.url ? <a href={p.url} target={p.url.startsWith('http') ? '_blank' : undefined} rel="noreferrer" class="hover:text-primary-600 transition-colors">{p.name} ↗</a> : p.name}
                </h3>
                <p class="text-gray-600 text-sm mb-3">{L(p.description)}</p>
                <div class="flex flex-wrap gap-2">
                  {p.tags.map((tag) => <span class="text-xs px-2.5 py-1 bg-white text-gray-600 rounded-full border border-gray-200">{tag}</span>)}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Languages -->
    <section class="py-20 px-6 bg-gray-50">
      <div class="container mx-auto">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-gray-900 mb-8">{lang === 'it' ? 'Lingue' : 'Languages'}</h2>
          <div class="grid md:grid-cols-2 gap-4">
            {data.languages.map((l) => (
              <div class="bg-white p-5 rounded-xl shadow-lg flex items-baseline justify-between">
                <span class="font-bold text-gray-900">{L(l.name)}</span>
                <span class="text-sm text-gray-500">{L(l.level)}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 px-6 bg-primary-600 text-white">
      <div class="container mx-auto text-center">
        <h2 class="text-4xl font-bold mb-6">{lang === 'it' ? 'Parliamo del tuo progetto' : "Let's talk about your project"}</h2>
        <p class="text-xl mb-8 text-primary-100 max-w-2xl mx-auto">
          {lang === 'it' ? '30 minuti gratuiti per capire priorità tecniche e opzioni concrete.' : '30 free minutes to understand technical priorities and concrete options.'}
        </p>
        <a href="/prenota" class="inline-block px-8 py-4 bg-white text-primary-600 rounded-lg hover:bg-gray-100 transition-all transform hover:scale-105 font-semibold shadow-lg">
          {lang === 'it' ? 'Prenota una call' : 'Book a call'}
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
