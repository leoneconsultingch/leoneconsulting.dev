---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Servizi AI, Data Science e Software | Leone Consulting" description="Servizi di AI Engineering, data science, sviluppo software e consulenza IT per PMI e startup: dall'analisi iniziale al rilascio, con KPI chiari e tempi certi.">
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="pt-32 pb-20 px-6 bg-gradient-to-br from-primary-50 to-white">
      <div class="container mx-auto">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-6">Servizi AI e Software orientati al risultato</h1>
          <p class="text-xl text-gray-600 leading-relaxed">
            Dall'analisi iniziale al rilascio: obiettivi chiari, deliverable definiti e KPI misurabili in ogni fase.
          </p>
        </div>
      </div>
    </section>

    <!-- AI Engineering -->
    <section id="ai" class="py-20 px-6">
      <div class="container mx-auto">
        <div class="max-w-6xl mx-auto">
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <div class="w-16 h-16 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
                <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>
              <h2 class="text-4xl font-bold text-gray-900 mb-6">Servizi di AI Engineering</h2>
              <p class="text-lg text-gray-600 mb-6 leading-relaxed">
                Sviluppiamo sistemi di intelligenza artificiale avanzati per automatizzare processi, 
                migliorare decisioni aziendali e creare esperienze utente innovative.
              </p>
              <p class="text-gray-600 mb-6">
                Le nostre soluzioni AI sono progettate su misura per le tue esigenze specifiche, 
                integrandosi perfettamente con i tuoi sistemi esistenti.
              </p>
            </div>
            <div class="bg-white p-8 rounded-xl shadow-lg">
              <h3 class="text-xl font-bold text-gray-900 mb-6">Cosa offriamo:</h3>
              <ul class="space-y-4">
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Machine Learning & Deep Learning</strong>
                    <p class="text-gray-600 text-sm">Modelli predittivi e sistemi di raccomandazione personalizzati</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Natural Language Processing</strong>
                    <p class="text-gray-600 text-sm">Analisi del testo, chatbot intelligenti e assistenti virtuali</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Computer Vision</strong>
                    <p class="text-gray-600 text-sm">Riconoscimento immagini e video analysis</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">AI documentale & LLM</strong>
                    <p class="text-gray-600 text-sm">Ricerca nei tuoi archivi, risposte con riferimenti alle fonti e pilot su processi concreti</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">MLOps & Deployment</strong>
                    <p class="text-gray-600 text-sm">Pipeline CI/CD per modelli ML e monitoring in produzione</p>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="ai-documentale" aria-labelledby="ai-documentale-title" class="scroll-mt-24 py-20 px-6 bg-primary-50">
      <div class="container mx-auto max-w-6xl">
        <div class="max-w-3xl mb-10">
          <p class="text-sm font-semibold text-primary-700 mb-3">AI documentale per il lavoro quotidiano</p>
          <h2 id="ai-documentale-title" class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">AI sui tuoi documenti, con fonti verificabili e controllo dei dati</h2>
          <p class="text-lg text-gray-600 leading-relaxed">Procedure, manuali e archivi diventano una base consultabile: parti da una domanda concreta e ritrova i passaggi pertinenti nei documenti. Prima del rilascio, verifichiamo insieme qualità delle risposte, accessi e utilità nel tuo processo.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-6 mb-12">
          <article class="rounded-xl border border-gray-200 bg-white p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-3">Trova le informazioni</h3>
            <p class="text-gray-600 leading-relaxed">Ricerca nei documenti aziendali, con OCR per le scansioni e riferimenti ai passaggi utilizzati per costruire la risposta.</p>
          </article>
          <article class="rounded-xl border border-gray-200 bg-white p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-3">Verifica prima di usare</h3>
            <p class="text-gray-600 leading-relaxed">Valutiamo pertinenza delle fonti e correttezza delle risposte. Se i documenti non bastano, il sistema deve segnalarlo; gli output critici restano soggetti a revisione umana.</p>
          </article>
          <article class="rounded-xl border border-gray-200 bg-white p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-3">Definisci chi vede cosa</h3>
            <p class="text-gray-600 leading-relaxed">Progettiamo il recupero delle informazioni secondo i permessi degli utenti e concordiamo gestione degli accessi, conservazione dei dati e tracciamento delle operazioni.</p>
          </article>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Locale, cloud o ibrido: la scelta parte dai vincoli</h3>
        <p class="text-gray-600 leading-relaxed max-w-3xl mb-6">Valutiamo riservatezza, utenti simultanei, tempi di risposta e capacità di gestione. Il luogo di esecuzione è una parte del progetto: vanno considerati anche OCR, indici, log, backup e integrazioni.</p>
        <div class="grid md:grid-cols-3 gap-6 mb-8">
          <article class="rounded-xl border border-gray-200 bg-white p-6">
            <h4 class="text-xl font-bold text-gray-900 mb-3">Locale / infrastruttura dedicata</h4>
            <p class="text-gray-600 leading-relaxed">Da valutare quando serve mantenere il trattamento nel perimetro concordato e controllare direttamente il sistema. Richiede risorse per capacità, aggiornamenti e continuità operativa.</p>
          </article>
          <article class="rounded-xl border border-gray-200 bg-white p-6">
            <h4 class="text-xl font-bold text-gray-900 mb-3">Cloud / API</h4>
            <p class="text-gray-600 leading-relaxed">Da valutare quando servizi esterni sono compatibili con dati e requisiti del progetto. Confrontiamo condizioni del fornitore, trattamento dei dati, limiti di servizio e costi a consumo.</p>
          </article>
          <article class="rounded-xl border border-gray-200 bg-white p-6">
            <h4 class="text-xl font-bold text-gray-900 mb-3">Ibrido</h4>
            <p class="text-gray-600 leading-relaxed">Da valutare quando attività diverse richiedono ambienti diversi. Stabiliamo quali dati possono attraversare ciascun confine e come verificare che l’instradamento rispetti le regole concordate.</p>
          </article>
        </div>
        <div class="rounded-xl border border-primary-200 bg-white p-6 mb-12">
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Un budget che comprende anche la gestione</h3>
          <p class="text-gray-600 leading-relaxed">La stima considera preparazione e aggiornamento dei documenti, integrazione con i sistemi esistenti, infrastruttura o consumo API, valutazione delle risposte e manutenzione. I costi dipendono da volumi, carico e requisiti: li stimiamo sul tuo caso, con ipotesi esplicite.</p>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-6">Prima una prova sul tuo lavoro, poi la decisione</h3>
        <ol class="grid md:grid-cols-3 gap-6 mb-12">
          <li class="rounded-xl border border-primary-100 bg-white p-6">
            <h4 class="text-xl font-bold text-gray-900 mb-3">1. Definiamo il caso d’uso</h4>
            <p class="text-gray-600 leading-relaxed">Scegliamo un processo, i documenti utilizzabili e il risultato atteso. Concordiamo criteri di accettazione prima di sviluppare.</p>
          </li>
          <li class="rounded-xl border border-primary-100 bg-white p-6">
            <h4 class="text-xl font-bold text-gray-900 mb-3">2. Costruiamo un pilot circoscritto</h4>
            <p class="text-gray-600 leading-relaxed">Usiamo documenti e domande rappresentativi, con accessi definiti. Confrontiamo il risultato con il processo attuale.</p>
          </li>
          <li class="rounded-xl border border-primary-100 bg-white p-6">
            <h4 class="text-xl font-bold text-gray-900 mb-3">3. Misuriamo e decidiamo</h4>
            <p class="text-gray-600 leading-relaxed">Valutiamo tempo di ricerca, correttezza delle risposte, riferimenti alle fonti e costi operativi. Il rilascio dipende dagli esiti della verifica.</p>
          </li>
        </ol>
        <h3 class="text-2xl font-bold text-gray-900 mb-6">Le domande da chiarire prima di partire</h3>
        <div class="space-y-4 mb-10">
          <details class="rounded-lg border border-gray-200 bg-white p-6">
            <summary class="cursor-pointer font-semibold text-gray-900">Serve un server dedicato?</summary>
            <p class="mt-4 text-gray-600 leading-relaxed">Lo valutiamo dopo aver definito dati, utenti simultanei e carico previsto. Un server locale, un ambiente dedicato o un servizio API rispondono a esigenze diverse; la scelta segue i requisiti del progetto.</p>
          </details>
          <details class="rounded-lg border border-gray-200 bg-white p-6">
            <summary class="cursor-pointer font-semibold text-gray-900">Come vengono gestiti i documenti?</summary>
            <p class="mt-4 text-gray-600 leading-relaxed">Prima del pilot definiamo dove vengono elaborati e conservati originali, indici e log, chi può consultarli e quali servizi possono riceverli. Queste scelte fanno parte del progetto e della configurazione concordata.</p>
          </details>
          <details class="rounded-lg border border-gray-200 bg-white p-6">
            <summary class="cursor-pointer font-semibold text-gray-900">Come verifichiamo che il sistema sia utile?</summary>
            <p class="mt-4 text-gray-600 leading-relaxed">Prepariamo domande rappresentative e risposte attese con chi conosce il processo. Verifichiamo anche documenti mancanti, risposte senza supporto e accessi non consentiti, oltre al tempo risparmiato e ai costi.</p>
          </details>
        </div>
        <div class="flex flex-col sm:flex-row gap-6 items-start sm:items-center">
          <a href="/prenota" class="inline-block px-6 py-3 rounded-lg bg-primary-600 text-white font-semibold hover:bg-primary-700 transition-colors">Parliamo del tuo processo documentale</a>
          <a href="/portfolio/lex-rag" class="text-primary-700 font-semibold underline underline-offset-4 hover:text-primary-800">Esplora LEX: ricerca documentale e fonti verificabili</a>
        </div>
      </div>
    </section>

    <!-- Data Science -->
    <section id="datascience" class="py-20 px-6 bg-gray-50">
      <div class="container mx-auto">
        <div class="max-w-6xl mx-auto">
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="order-2 md:order-1 bg-white p-8 rounded-xl shadow-lg">
              <h3 class="text-xl font-bold text-gray-900 mb-6">Cosa offriamo:</h3>
              <ul class="space-y-4">
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Data Analytics & BI</strong>
                    <p class="text-gray-600 text-sm">Analisi dati avanzate e dashboard interattivi per decisioni consapevoli</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Predictive Modeling</strong>
                    <p class="text-gray-600 text-sm">Modelli predittivi per prevedere trend e comportamenti futuri</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Big Data Processing</strong>
                    <p class="text-gray-600 text-sm">Gestione e elaborazione di grandi volumi di dati con tecnologie distribuite</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Statistical Analysis</strong>
                    <p class="text-gray-600 text-sm">Analisi statistiche approfondite e inferenza dai dati</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Data Visualization</strong>
                    <p class="text-gray-600 text-sm">Rappresentazione visiva dei dati per comunicare insights efficacemente</p>
                  </div>
                </li>
              </ul>
            </div>
            <div class="order-1 md:order-2">
              <div class="w-16 h-16 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
                <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
                </svg>
              </div>
              <h2 class="text-4xl font-bold text-gray-900 mb-6">Data Science</h2>
              <p class="text-lg text-gray-600 mb-6 leading-relaxed">
                Trasformiamo i tuoi dati in insight strategici e azioni concrete. Le nostre soluzioni 
                di data science aiutano il tuo business a prendere decisioni basate sui dati.
              </p>
              <p class="text-gray-600 mb-6">
                Dalla raccolta e preparazione dei dati all'analisi avanzata e alla visualizzazione, 
                seguiamo un approccio olistico per estrarre il massimo valore dai tuoi dati.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Software Development -->
    <section id="development" class="py-20 px-6 bg-gray-50">
      <div class="container mx-auto">
        <div class="max-w-6xl mx-auto">
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="order-2 md:order-1 bg-white p-8 rounded-xl shadow-lg">
              <h3 class="text-xl font-bold text-gray-900 mb-6">Cosa offriamo:</h3>
              <ul class="space-y-4">
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Applicazioni Web</strong>
                    <p class="text-gray-600 text-sm">SPA, PWA e applicazioni web moderne con React, Vue, Astro</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">API & Backend</strong>
                    <p class="text-gray-600 text-sm">RESTful API, GraphQL, microservizi con Node.js, Python, FastAPI</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Database Design</strong>
                    <p class="text-gray-600 text-sm">PostgreSQL, MySQL, MongoDB, Redis - schema design e ottimizzazione</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Cloud Native</strong>
                    <p class="text-gray-600 text-sm">Applicazioni scalabili su AWS, Azure, GCP</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Mobile Development</strong>
                    <p class="text-gray-600 text-sm">App native e cross-platform con React Native</p>
                  </div>
                </li>
              </ul>
            </div>
            <div class="order-1 md:order-2">
              <div class="w-16 h-16 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
                <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <h2 class="text-4xl font-bold text-gray-900 mb-6">Sviluppo software su misura</h2>
              <p class="text-lg text-gray-600 mb-6 leading-relaxed">
                Creiamo software su misura utilizzando le tecnologie più moderne e le best practice 
                di sviluppo per garantire codice pulito, scalabile e manutenibile.
              </p>
              <p class="text-gray-600 mb-6">
                Dalla progettazione all'implementazione fino al deployment, seguiamo il tuo progetto 
                in ogni fase con metodologie agile e comunicazione trasparente.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- IT Consulting -->
    <section id="consulting" class="py-20 px-6">
      <div class="container mx-auto">
        <div class="max-w-6xl mx-auto">
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <div class="w-16 h-16 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
                <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <h2 class="text-4xl font-bold text-gray-900 mb-6">Consulenza IT orientata ai KPI</h2>
              <p class="text-lg text-gray-600 mb-6 leading-relaxed">
                Offriamo consulenza strategica e tecnica per aiutarti a prendere le decisioni giuste 
                e guidare il tuo business verso il successo tecnologico.
              </p>
              <p class="text-gray-600 mb-6">
                Analizziamo il tuo contesto, identifichiamo opportunità di miglioramento e 
                definiamo roadmap tecnologiche chiare e realizzabili.
              </p>
            </div>
            <div class="bg-white p-8 rounded-xl shadow-lg">
              <h3 class="text-xl font-bold text-gray-900 mb-6">Cosa offriamo:</h3>
              <ul class="space-y-4">
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Architettura Software</strong>
                    <p class="text-gray-600 text-sm">Design di sistemi scalabili e manutenibili</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Code Review & Refactoring</strong>
                    <p class="text-gray-600 text-sm">Analisi del codice e miglioramento della qualità</p>
                  </div>
                </li>
                <li class="flex items-start">
