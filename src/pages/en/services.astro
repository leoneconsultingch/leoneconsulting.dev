---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="AI, Data Science & Software Services | Leone Consulting" description="AI engineering, data science, software development and IT consulting for SMEs and startups, from technical assessment to delivery with clear KPIs and timelines.">
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="pt-32 pb-20 px-6 bg-gradient-to-br from-primary-50 to-white">
      <div class="container mx-auto">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-6">AI and Software Services focused on outcomes</h1>
          <p class="text-xl text-gray-600 leading-relaxed">
            From technical assessment to delivery: clear objectives, concrete deliverables, and measurable KPIs in every phase.
          </p>
        </div>
      </div>
    </section>

    <!-- AI Engineering -->
    <section id="ai" class="py-20 px-6">
      <div class="container mx-auto">
        <div class="max-w-6xl mx-auto">
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <div class="w-16 h-16 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
                <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>
              <h2 class="text-4xl font-bold text-gray-900 mb-6">AI engineering services</h2>
              <p class="text-lg text-gray-600 mb-6 leading-relaxed">
                We develop advanced artificial intelligence systems to automate processes, 
                improve business decisions and create innovative user experiences.
              </p>
              <p class="text-gray-600 mb-6">
                Our AI solutions are designed to fit your specific needs, 
                integrating seamlessly with your existing systems.
              </p>
            </div>
            <div class="bg-white p-8 rounded-xl shadow-lg">
              <h3 class="text-xl font-bold text-gray-900 mb-6">What we offer:</h3>
              <ul class="space-y-4">
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Machine Learning & Deep Learning</strong>
                    <p class="text-gray-600 text-sm">Predictive models and personalized recommendation systems</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Natural Language Processing</strong>
                    <p class="text-gray-600 text-sm">Text analysis, intelligent chatbots and virtual assistants</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Computer Vision</strong>
                    <p class="text-gray-600 text-sm">Image recognition and video analysis</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Document AI & LLMs</strong>
                    <p class="text-gray-600 text-sm">Search your archives, get answers with source references and test practical workflows in a pilot</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">MLOps & Deployment</strong>
                    <p class="text-gray-600 text-sm">CI/CD pipelines for ML models and production monitoring</p>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="document-ai" aria-labelledby="document-ai-title" class="scroll-mt-24 py-20 px-6 bg-primary-50">
      <div class="container mx-auto max-w-6xl">
        <div class="max-w-3xl mb-10">
          <p class="text-sm font-semibold text-primary-700 mb-3">Document AI for everyday work</p>
          <h2 id="document-ai-title" class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">AI for your documents, with verifiable sources and control over your data</h2>
          <p class="text-lg text-gray-600 leading-relaxed">Turn procedures, manuals and archives into a searchable knowledge base: start with a practical question and find the relevant passages. Before release, we assess answer quality, access controls and usefulness in your workflow together.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-6 mb-12">
          <article class="rounded-xl border border-gray-200 bg-white p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-3">Find the information</h3>
            <p class="text-gray-600 leading-relaxed">Search company documents, with OCR for scanned pages and references to the passages used to build each answer.</p>
          </article>
          <article class="rounded-xl border border-gray-200 bg-white p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-3">Verify before use</h3>
            <p class="text-gray-600 leading-relaxed">We assess source relevance and answer correctness. When documents provide insufficient evidence, the system should say so; critical outputs remain subject to human review.</p>
          </article>
          <article class="rounded-xl border border-gray-200 bg-white p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-3">Define who can see what</h3>
            <p class="text-gray-600 leading-relaxed">We design retrieval around user permissions and agree on access management, data retention and activity logging.</p>
          </article>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Local, cloud or hybrid: start with your constraints</h3>
        <p class="text-gray-600 leading-relaxed max-w-3xl mb-6">We assess confidentiality, concurrent users, response times and operational capacity. Where the model runs is one part of the design: OCR, indexes, logs, backups and integrations also need consideration.</p>
        <div class="grid md:grid-cols-3 gap-6 mb-8">
          <article class="rounded-xl border border-gray-200 bg-white p-6">
            <h4 class="text-xl font-bold text-gray-900 mb-3">Local / dedicated infrastructure</h4>
            <p class="text-gray-600 leading-relaxed">Consider this when processing must stay within an agreed boundary and direct system control matters. It requires resources for capacity, updates and operational continuity.</p>
          </article>
          <article class="rounded-xl border border-gray-200 bg-white p-6">
            <h4 class="text-xl font-bold text-gray-900 mb-3">Cloud / APIs</h4>
            <p class="text-gray-600 leading-relaxed">Consider this when external services are compatible with your data and project requirements. We compare provider terms, data handling, service limits and usage costs.</p>
          </article>
          <article class="rounded-xl border border-gray-200 bg-white p-6">
            <h4 class="text-xl font-bold text-gray-900 mb-3">Hybrid</h4>
            <p class="text-gray-600 leading-relaxed">Consider this when different tasks need different environments. We define which data may cross each boundary and how to verify that routing follows the agreed rules.</p>
          </article>
        </div>
        <div class="rounded-xl border border-primary-200 bg-white p-6 mb-12">
          <h3 class="text-2xl font-bold text-gray-900 mb-4">A budget that includes ongoing operations</h3>
          <p class="text-gray-600 leading-relaxed">The estimate covers document preparation and updates, integration with existing systems, infrastructure or API usage, answer evaluation and maintenance. Costs depend on volumes, load and requirements: we estimate them for your case, with explicit assumptions.</p>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-6">Test it on your workflow, then decide</h3>
        <ol class="grid md:grid-cols-3 gap-6 mb-12">
          <li class="rounded-xl border border-primary-100 bg-white p-6">
            <h4 class="text-xl font-bold text-gray-900 mb-3">1. Define the use case</h4>
            <p class="text-gray-600 leading-relaxed">Choose a process, the documents that may be used and the intended outcome. Agree on acceptance criteria before development.</p>
          </li>
          <li class="rounded-xl border border-primary-100 bg-white p-6">
            <h4 class="text-xl font-bold text-gray-900 mb-3">2. Build a focused pilot</h4>
            <p class="text-gray-600 leading-relaxed">Use representative documents and questions, with defined access controls. Compare the outcome with your current process.</p>
          </li>
          <li class="rounded-xl border border-primary-100 bg-white p-6">
            <h4 class="text-xl font-bold text-gray-900 mb-3">3. Measure and decide</h4>
            <p class="text-gray-600 leading-relaxed">Assess search time, answer correctness, source references and operating costs. Release depends on the evaluation results.</p>
          </li>
        </ol>
        <h3 class="text-2xl font-bold text-gray-900 mb-6">Questions to answer before starting</h3>
        <div class="space-y-4 mb-10">
          <details class="rounded-lg border border-gray-200 bg-white p-6">
            <summary class="cursor-pointer font-semibold text-gray-900">Do we need a dedicated server?</summary>
            <p class="mt-4 text-gray-600 leading-relaxed">We assess this after defining your data, concurrent users and expected load. A local server, a dedicated environment and an API service address different needs; project requirements guide the choice.</p>
          </details>
          <details class="rounded-lg border border-gray-200 bg-white p-6">
            <summary class="cursor-pointer font-semibold text-gray-900">How are documents handled?</summary>
            <p class="mt-4 text-gray-600 leading-relaxed">Before the pilot, we define where originals, indexes and logs are processed and stored, who can access them and which services may receive them. These choices form part of the agreed design and configuration.</p>
          </details>
          <details class="rounded-lg border border-gray-200 bg-white p-6">
            <summary class="cursor-pointer font-semibold text-gray-900">How do we know the system is useful?</summary>
            <p class="mt-4 text-gray-600 leading-relaxed">We prepare representative questions and expected answers with the people who know the process. We test missing documents, unsupported answers and unauthorized access, alongside time savings and costs.</p>
          </details>
        </div>
        <div class="flex flex-col sm:flex-row gap-6 items-start sm:items-center">
          <a href="/en/book-call" class="inline-block px-6 py-3 rounded-lg bg-primary-600 text-white font-semibold hover:bg-primary-700 transition-colors">Discuss your document workflow</a>
          <a href="/en/portfolio/lex-rag" class="text-primary-700 font-semibold underline underline-offset-4 hover:text-primary-800">Explore LEX: document search and verifiable sources</a>
        </div>
      </div>
    </section>

    <!-- Data Science -->
    <section id="datascience" class="py-20 px-6 bg-gray-50">
      <div class="container mx-auto">
        <div class="max-w-6xl mx-auto">
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="order-2 md:order-1 bg-white p-8 rounded-xl shadow-lg">
              <h3 class="text-xl font-bold text-gray-900 mb-6">What we offer:</h3>
              <ul class="space-y-4">
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Data Analytics & BI</strong>
                    <p class="text-gray-600 text-sm">Advanced data analysis and interactive dashboards for informed decisions</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Predictive Modeling</strong>
                    <p class="text-gray-600 text-sm">Predictive models to forecast trends and future behaviors</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Big Data Processing</strong>
                    <p class="text-gray-600 text-sm">Management and processing of large data volumes with distributed technologies</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Statistical Analysis</strong>
                    <p class="text-gray-600 text-sm">In-depth statistical analysis and data inference</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Data Visualization</strong>
                    <p class="text-gray-600 text-sm">Visual data representation to communicate insights effectively</p>
                  </div>
                </li>
              </ul>
            </div>
            <div class="order-1 md:order-2">
              <div class="w-16 h-16 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
                <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
                </svg>
              </div>
              <h2 class="text-4xl font-bold text-gray-900 mb-6">Data Science</h2>
              <p class="text-lg text-gray-600 mb-6 leading-relaxed">
                We transform your data into strategic insights and concrete actions. Our data science solutions 
                help your business make data-driven decisions.
              </p>
              <p class="text-gray-600 mb-6">
                From data collection and preparation to advanced analysis and visualization, 
                we follow a holistic approach to extract maximum value from your data.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Software Development -->
    <section id="development" class="py-20 px-6 bg-gray-50">
      <div class="container mx-auto">
        <div class="max-w-6xl mx-auto">
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="order-2 md:order-1 bg-white p-8 rounded-xl shadow-lg">
              <h3 class="text-xl font-bold text-gray-900 mb-6">What we offer:</h3>
              <ul class="space-y-4">
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Web Applications</strong>
                    <p class="text-gray-600 text-sm">SPA, PWA and modern web apps with React, Vue, Astro</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">API & Backend</strong>
                    <p class="text-gray-600 text-sm">RESTful API, GraphQL, microservices with Node.js, Python, FastAPI</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Database Design</strong>
                    <p class="text-gray-600 text-sm">PostgreSQL, MySQL, MongoDB, Redis - schema design and optimization</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Cloud Native</strong>
                    <p class="text-gray-600 text-sm">Scalable applications on AWS, Azure, GCP</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Mobile Development</strong>
                    <p class="text-gray-600 text-sm">Native and cross-platform apps with React Native</p>
                  </div>
                </li>
              </ul>
            </div>
            <div class="order-1 md:order-2">
              <div class="w-16 h-16 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
                <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <h2 class="text-4xl font-bold text-gray-900 mb-6">Custom software delivery</h2>
              <p class="text-lg text-gray-600 mb-6 leading-relaxed">
                We create custom software using the most modern technologies and development 
                best practices to ensure clean, scalable and maintainable code.
              </p>
              <p class="text-gray-600 mb-6">
                From design to implementation to deployment, we follow your project 
                through every phase with agile methodologies and transparent communication.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- IT Consulting -->
    <section id="consulting" class="py-20 px-6">
      <div class="container mx-auto">
        <div class="max-w-6xl mx-auto">
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <div class="w-16 h-16 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
                <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <h2 class="text-4xl font-bold text-gray-900 mb-6">IT consulting with clear KPIs</h2>
              <p class="text-lg text-gray-600 mb-6 leading-relaxed">
                We offer strategic and technical consulting to help you make the right decisions 
                and guide your business towards technological success.
              </p>
              <p class="text-gray-600 mb-6">
                We analyze your context, identify improvement opportunities and 
                define clear and achievable technology roadmaps.
              </p>
            </div>
            <div class="bg-white p-8 rounded-xl shadow-lg">
              <h3 class="text-xl font-bold text-gray-900 mb-6">What we offer:</h3>
              <ul class="space-y-4">
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Software Architecture</strong>
                    <p class="text-gray-600 text-sm">Design of scalable and maintainable systems</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Code Review & Refactoring</strong>
                    <p class="text-gray-600 text-sm">Code analysis and quality improvement</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Technical Due Diligence</strong>
                    <p class="text-gray-600 text-sm">Technical assessment for M&A and investments</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">DevOps & CI/CD</strong>
                    <p class="text-gray-600 text-sm">Automation, deployment and infrastructure as code</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <div>
                    <strong class="text-gray-900">Technology Strategy</strong>
                    <p class="text-gray-600 text-sm">Technology roadmap and technology selection</p>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="py-20 px-6 bg-gray-50">
      <div class="container mx-auto">
        <div class="max-w-4xl mx-auto text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-900 mb-6">Our Process</h2>
          <p class="text-xl text-gray-600">
            A structured approach to ensure your project's success
          </p>
        </div>

        <div class="grid md:grid-cols-4 gap-8 max-w-6xl mx-auto">
          <div class="text-center">
            <div class="w-16 h-16 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-4 text-white text-2xl font-bold">
              1
