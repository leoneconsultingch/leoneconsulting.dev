---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import PackageCard from '../../components/PackageCard.astro';
import { useTranslations } from '../../i18n/translations';
import type { CaseStudy } from '../../types/case-study';
import type { Package } from '../../types/package';

// Import case studies
import dashboardOps from '../../../company/case-studies/dashboard-kpi-operations.en.json';
import aiClassifier from '../../../company/case-studies/prototipo-ai-classificazione.en.json';
import ecommercePipeline from '../../../company/case-studies/pipeline-analytics-ecommerce.en.json';
import multiAgentHFT from '../../../company/case-studies/multiagenthft.en.json';
import predictiveAnalytics from '../../../company/case-studies/predictive-analytics-ml.en.json';
import finllm from '../../../company/case-studies/finllm.en.json';

// Import packages (English versions)
import techAudit from '../../../company/packages/tech-audit.en.json';
import mvpSprint from '../../../company/packages/mvp-sprint.en.json';
import dataPipeline from '../../../company/packages/data-pipeline.en.json';

const t = useTranslations('en');

const featuredCaseStudies: CaseStudy[] = [
  dashboardOps as CaseStudy,
  aiClassifier as CaseStudy,
  ecommercePipeline as CaseStudy,
  multiAgentHFT as CaseStudy,
  predictiveAnalytics as CaseStudy,
  finllm as CaseStudy,
].filter(cs => cs.published).slice(0, 3);

const packages: Package[] = [
  techAudit as Package,
  mvpSprint as Package,
  dataPipeline as Package,
].filter(pkg => pkg.metadata.featured);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Leone Consulting',
  url: 'https://leoneconsulting.dev/en/',
  inLanguage: 'en-US',
  potentialAction: {
    '@type': 'ContactAction',
    target: 'https://leoneconsulting.dev/en/contact',
    name: 'Request a consultation',
  },
};
---

<Layout
  title="AI & Software Consulting for SMEs | Leone Consulting"
  description="AI engineering, software development and data engineering consulting for SMEs and startups, with rapid execution, measurable outcomes and technical direction."
  schema={websiteSchema}
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="pt-32 pb-20 px-6 bg-gradient-to-br from-primary-50 to-white">
      <div class="container mx-auto">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-6 leading-tight">
            I turn AI and data ideas into
            <span class="text-primary-600">products with measurable impact</span>
          </h1>
          <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            I help SMEs and startups launch MVPs, automations, and data pipelines with clear scope,
            realistic timelines, and shared KPIs from day one.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href="/en/book-call" 
              class="px-8 py-4 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-all transform hover:scale-105 font-semibold shadow-lg"
            >
              Book a Free Call
            </a>
            <a 
              href="/en/async-audit" 
              class="px-8 py-4 bg-white text-primary-600 border-2 border-primary-600 rounded-lg hover:bg-primary-50 transition-all font-semibold"
            >
              Request Async Audit
            </a>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="document-ai-intro" class="py-16 px-6 bg-primary-50">
      <div class="container mx-auto max-w-5xl">
        <div class="grid md:grid-cols-3 gap-8 items-center">
          <div class="md:col-span-2">
            <h2 id="document-ai-intro" class="text-3xl font-bold text-gray-900 mb-4">Are the answers you need already in your documents?</h2>
            <p class="text-lg text-gray-600 leading-relaxed">We build assistants to search procedures, manuals and archives with source references. A pilot helps assess quality, access controls and costs, choosing between local, cloud and hybrid deployment.</p>
          </div>
          <a href="/en/services#document-ai" class="inline-block justify-self-start px-6 py-3 rounded-lg bg-primary-600 text-white font-semibold hover:bg-primary-700 transition-colors">Explore document AI</a>
        </div>
      </div>
    </section>

    <!-- Scientific Method Section -->
    <section class="py-20 px-6 bg-white border-t border-b border-gray-100">
      <div class="container mx-auto">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <div class="inline-block px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold mb-6">
                Our Differentiator
              </div>
              <h2 class="text-4xl font-bold text-gray-900 mb-6">AI and software consulting for SMEs</h2>
              <p class="text-xl text-gray-600 mb-6 leading-relaxed">
                Unlike many in the industry, we rigorously apply the scientific method 
                to IT and AI projects. Not opinions, not trends: only data, verifiable hypotheses, and measurable results.
              </p>
              <p class="text-lg text-gray-600 mb-8 leading-relaxed">
                Every decision is supported by evidence. Every solution is tested and validated. 
                This approach ensures safe investments and concrete results, not promises.
              </p>
              <div class="space-y-4">
                <div class="flex items-start space-x-3">
                  <svg class="w-6 h-6 text-primary-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <div>
                    <h4 class="font-bold text-gray-900">Data-driven analysis</h4>
                    <p class="text-gray-600">We collect and analyze real data, not assumptions</p>
                  </div>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-6 h-6 text-primary-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <div>
                    <h4 class="font-bold text-gray-900">Verifiable hypotheses</h4>
                    <p class="text-gray-600">We formulate testable solutions with clear success criteria</p>
                  </div>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-6 h-6 text-primary-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <div>
                    <h4 class="font-bold text-gray-900">Measurable results</h4>
                    <p class="text-gray-600">Every project has concrete KPIs and success metrics</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="bg-gradient-to-br from-primary-50 to-white p-8 rounded-2xl shadow-xl">
              <div class="text-6xl font-bold text-primary-600 mb-4">1+2+3</div>
              <h3 class="text-2xl font-bold text-gray-900 mb-4">Observe → Hypothesize → Test</h3>
              <p class="text-gray-600 mb-6 leading-relaxed">
                The virtuous cycle that guarantees solid solutions and protected investments. 
                We don't improvise: every step is documented, every choice is justified.
              </p>
              <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-primary-600">
                <p class="text-sm text-gray-500 mb-2">Commercial approach</p>
                <p class="font-semibold text-gray-900">
                  "Investing in technology with the scientific method means having concrete guarantees, 
                  not just market promises."
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Results Section -->
    <section class="py-20 px-6 bg-gray-50">
      <div class="container mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-900 mb-4">Measured outcomes from real projects</h2>
          <p class="text-xl text-gray-600">Case studies with real numbers, not just slides</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
          {featuredCaseStudies.map(caseStudy => (
            <CaseStudyCard caseStudy={caseStudy} />
          ))}
        </div>

        <div class="text-center mt-12">
          <a 
            href="/en/portfolio" 
            class="inline-flex items-center px-8 py-4 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-all transform hover:scale-105 font-semibold shadow-lg"
          >
            Real Case Studies
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Packages Section -->
    <section class="py-20 px-6">
      <div class="container mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-900 mb-4">How we work: from problem to delivery</h2>
          <p class="text-xl text-gray-600">Clear packages for different needs</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
          {packages.map(pkg => (
            <PackageCard package={pkg} />
          ))}
        </div>

        <div class="text-center mt-12">
          <a 
            href="/en/packages" 
            class="inline-flex items-center px-8 py-4 bg-white text-primary-600 border-2 border-primary-600 rounded-lg hover:bg-primary-50 transition-all font-semibold"
          >
            View all packages
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Services Preview -->
    <section class="py-20 px-6 bg-gray-50">
      <div class="container mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-900 mb-4">{t('services.title')}</h2>
          <p class="text-xl text-gray-600">{t('services.subtitle')}</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- AI Engineering -->
          <div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2 border border-gray-100">
            <div class="w-16 h-16 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">{t('services.ai.title')}</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              {t('services.ai.description')}
            </p>
            <a href="/en/services#ai" class="text-primary-600 font-semibold hover:text-primary-700 transition-colors inline-flex items-center">
              {t('services.ai.cta')}
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

          <!-- Data Science -->
          <div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2 border border-gray-100">
            <div class="w-16 h-16 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">{t('services.datascience.title')}</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              {t('services.datascience.description')}
            </p>
            <a href="/en/services#datascience" class="text-primary-600 font-semibold hover:text-primary-700 transition-colors inline-flex items-center">
              {t('services.ai.cta')}
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

          <!-- Software Development -->
          <div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2 border border-gray-100">
            <div class="w-16 h-16 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">{t('services.dev.title')}</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              {t('services.dev.description')}
            </p>
            <a href="/en/services#development" class="text-primary-600 font-semibold hover:text-primary-700 transition-colors inline-flex items-center">
              {t('services.ai.cta')}
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

          <!-- IT Consulting -->
          <div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2 border border-gray-100">
            <div class="w-16 h-16 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">{t('services.consulting.title')}</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              {t('services.consulting.description')}
            </p>
            <a href="/en/services#consulting" class="text-primary-600 font-semibold hover:text-primary-700 transition-colors inline-flex items-center">
              {t('services.ai.cta')}
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="py-20 px-6 bg-gray-50">
      <div class="container mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-900 mb-4">{t('why.title')}</h2>
          <p class="text-xl text-gray-600">{t('why.subtitle')}</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="text-center">
            <div class="w-20 h-20 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">{t('why.speed')}</h3>
            <p class="text-gray-600">{t('why.speed.desc')}</p>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">{t('why.quality')}</h3>
            <p class="text-gray-600">{t('why.quality.desc')}</p>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">{t('why.experience')}</h3>
            <p class="text-gray-600">{t('why.experience.desc')}</p>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">{t('why.partnership')}</h3>
            <p class="text-gray-600">{t('why.partnership.desc')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 px-6 bg-primary-600 text-white">
      <div class="container mx-auto text-center">
        <h2 class="text-4xl font-bold mb-6">Need clarity on your next technical step?</h2>
        <p class="text-xl mb-8 text-primary-100 max-w-2xl mx-auto">
          In a focused 30-minute call, we map priorities, risks, and delivery options. 
          If there is no fit, you still get a practical alternative.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/en/book-call" 
            class="inline-block px-8 py-4 bg-white text-primary-600 rounded-lg hover:bg-gray-100 transition-all transform hover:scale-105 font-semibold shadow-lg"
          >
            Book a Free Call
          </a>
          <a 
            href="/en/async-audit" 
            class="inline-block px-8 py-4 bg-primary-700 text-white border-2 border-white rounded-lg hover:bg-primary-800 transition-all font-semibold"
          >
            Request Async Audit
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
