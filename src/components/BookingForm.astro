---
interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;

const text = {
  it: {
    contact: 'Informazioni di Contatto',
    success: 'Prenotazione ricevuta. Ti contatteremo entro 24 ore per confermare.',
    error: 'Si è verificato un errore. Riprova o contattaci direttamente.',
    invalidEmail: 'Email non valida',
    tooMany: 'Troppi tentativi. Attendi un minuto.',
    sending: 'Invio in corso...',
    submit: 'Conferma Prenotazione',
  },
  en: {
    contact: 'Contact Information',
    success: 'Booking received. We will contact you within 24 hours to confirm.',
    error: 'An error occurred. Please try again or contact us directly.',
    invalidEmail: 'Invalid email address',
    tooMany: 'Too many attempts. Please wait a minute.',
    sending: 'Sending...',
    submit: 'Confirm Booking',
  },
}[lang];
---

<form id={`booking-form-${lang}`} class="space-y-6" data-lang={lang}>
  <div>
    <label for={`service-${lang}`} class="block text-sm font-semibold text-gray-900 mb-2">
      {lang === 'en' ? 'Service' : 'Servizio'} *
    </label>
    <select
      id={`service-${lang}`}
      name="service"
      required
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all"
    >
      <option value="">{lang === 'en' ? 'Select a service' : 'Seleziona un servizio'}</option>
      <option value="AI Engineering">AI Engineering</option>
      <option value="Software Development">{lang === 'en' ? 'Software Development' : 'Sviluppo Software'}</option>
      <option value="IT Consulting">{lang === 'en' ? 'IT Consulting' : 'Consulenza IT'}</option>
    </select>
  </div>

  <div class="grid md:grid-cols-2 gap-6">
    <div>
      <label for={`date-${lang}`} class="block text-sm font-semibold text-gray-900 mb-2">
        {lang === 'en' ? 'Preferred date' : 'Data preferita'} *
      </label>
      <input
        type="date"
        id={`date-${lang}`}
        name="date"
        required
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all"
      />
    </div>

    <div>
      <label for={`time-${lang}`} class="block text-sm font-semibold text-gray-900 mb-2">
        {lang === 'en' ? 'Preferred time' : 'Orario preferito'} *
      </label>
      <select
        id={`time-${lang}`}
        name="time"
        required
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all"
      >
        <option value="15-16">15:00 - 16:00</option>
        <option value="16-17">16:00 - 17:00</option>
        <option value="17-18">17:00 - 18:00</option>
      </select>
    </div>
  </div>

  <div>
    <label class="block text-sm font-semibold text-gray-900 mb-2">
      {lang === 'en' ? 'Consultation type' : 'Tipo consulenza'}
    </label>
    <p class="text-sm text-gray-700">{lang === 'en' ? 'Online video call' : 'Call online'}</p>
    <input type="hidden" name="type" value="online" />
  </div>

  <div class="pt-4 border-t border-gray-200">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">{text.contact}</h3>

    <div class="space-y-6">
      <div>
        <label for={`name-${lang}`} class="block text-sm font-semibold text-gray-900 mb-2">
          {lang === 'en' ? 'Name' : 'Nome'} *
        </label>
        <input
          type="text"
          id={`name-${lang}`}
          name="name"
          required
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all"
        />
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label for={`email-${lang}`} class="block text-sm font-semibold text-gray-900 mb-2">
            Email *
          </label>
          <input
            type="email"
            id={`email-${lang}`}
            name="email"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all"
          />
        </div>

        <div>
          <label for={`phone-${lang}`} class="block text-sm font-semibold text-gray-900 mb-2">
            {lang === 'en' ? 'Phone' : 'Telefono'} *
          </label>
          <input
            type="tel"
            id={`phone-${lang}`}
            name="phone"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all"
          />
        </div>
      </div>

      <div>
        <label for={`company-${lang}`} class="block text-sm font-semibold text-gray-900 mb-2">
          {lang === 'en' ? 'Company' : 'Azienda'}
        </label>
        <input
          type="text"
          id={`company-${lang}`}
          name="company"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all"
        />
      </div>

      <div>
        <label for={`notes-${lang}`} class="block text-sm font-semibold text-gray-900 mb-2">
          {lang === 'en' ? 'Notes' : 'Note'}
        </label>
        <textarea
          id={`notes-${lang}`}
          name="notes"
          rows="4"
          placeholder={lang === 'en' ? 'Project context, goals, constraints...' : 'Contesto progetto, obiettivi, vincoli...'}
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all resize-none"
        ></textarea>
      </div>
    </div>
  </div>

  <div class="flex items-start space-x-3">
    <input
      type="checkbox"
      id={`privacy-${lang}`}
      name="privacy"
      required
      class="w-4 h-4 mt-1 text-primary-600 focus:ring-primary-500 rounded"
    />
    <label for={`privacy-${lang}`} class="text-sm text-gray-600">
      {lang === 'en'
        ? 'I have read and accept the privacy policy.'
        : 'Ho letto e accetto la privacy policy.'}
    </label>
  </div>

  <button
    type="submit"
    class="w-full px-8 py-4 bg-primary-600 text-white rounded-lg font-semibold hover:bg-primary-700 transition-all transform hover:scale-[1.02] disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none"
  >
    {text.submit}
  </button>

  <div id={`booking-status-${lang}`} class="hidden p-4 rounded-lg text-center"></div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form[id^="booking-form-"]').forEach((form) => {
    const lang = form.dataset.lang === 'en' ? 'en' : 'it';
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const statusMessage = document.getElementById(`booking-status-${lang}`) as HTMLDivElement | null;
    const dateInput = form.querySelector<HTMLInputElement>('input[type="date"]');

    const messages = {
      it: {
        tooMany: 'Troppi tentativi. Attendi un minuto.',
        invalidEmail: 'Email non valida',
        sending: 'Invio in corso...',
        submit: 'Conferma Prenotazione',
        success: 'Prenotazione ricevuta. Ti contatteremo entro 24 ore per confermare.',
        error: 'Si è verificato un errore. Riprova o contattaci direttamente.',
      },
      en: {
        tooMany: 'Too many attempts. Please wait a minute.',
        invalidEmail: 'Invalid email address',
        sending: 'Sending...',
        submit: 'Confirm Booking',
        success: 'Booking received. We will contact you within 24 hours to confirm.',
        error: 'An error occurred. Please try again or contact us directly.',
      },
    }[lang];

    if (dateInput) {
      dateInput.min = new Date().toISOString().split('T')[0];
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!submitButton || !statusMessage) return;

      const formData = new FormData(form);
      const email = String(formData.get('email') || '');

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        statusMessage.textContent = messages.invalidEmail;
        statusMessage.className = 'block p-4 rounded-lg text-center bg-red-100 text-red-700';
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = messages.sending;
      statusMessage.className = 'hidden';

      const payload = {
        service: formData.get('service'),
        date: formData.get('date'),
        time: formData.get('time'),
        type: formData.get('type'),
        name: formData.get('name'),
        email,
        phone: formData.get('phone'),
        company: formData.get('company') || '',
        notes: formData.get('notes') || '',
        privacy: formData.get('privacy') === 'on',
      };

      try {
        const response = await fetch('/api/booking', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!response.ok) {
          throw new Error(`Booking request failed: ${response.status}`);
        }

        statusMessage.textContent = messages.success;
        statusMessage.className = 'block p-4 rounded-lg text-center bg-green-100 text-green-700';
        form.reset();
        if (dateInput) {
          dateInput.min = new Date().toISOString().split('T')[0];
        }
      } catch {
        statusMessage.textContent = messages.error;
        statusMessage.className = 'block p-4 rounded-lg text-center bg-red-100 text-red-700';
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = messages.submit;
      }
    });
  });
</script>
