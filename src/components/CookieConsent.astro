---
interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;

const texts = {
  it: {
    message: "Utilizziamo Google Analytics solo con il tuo consenso per misurare le visite. Puoi accettare, rifiutare o modificare la scelta in qualsiasi momento. Dettagli nella",
    privacy: "Privacy Policy",
    accept: "Accetta",
    decline: "Rifiuta",
    settings: "Impostazioni"
  },
  en: {
    message: "We use Google Analytics only with your consent to measure visits. You can accept, decline or change your choice at any time. Details in our",
    privacy: "Privacy Policy",
    accept: "Accept",
    decline: "Decline",
    settings: "Settings"
  }
};

const t = texts[lang];
const privacyUrl = lang === 'it' ? '/privacy' : '/en/privacy';
---

<div id="cookie-banner" class="cookie-banner hidden">
  <div class="cookie-content">
    <div class="cookie-text">
      <p>
        {t.message} <a href={privacyUrl} class="cookie-link">{t.privacy}</a>.
      </p>
    </div>
    <div class="cookie-actions">
      <button id="cookie-settings" class="btn-secondary">{t.settings}</button>
      <button id="cookie-decline" class="btn-secondary">{t.decline}</button>
      <button id="cookie-accept" class="btn-primary">{t.accept}</button>
    </div>
  </div>
</div>

<button id="cookie-reopen" style="position:fixed;bottom:0.5rem;left:0.5rem;z-index:9998;background:white;padding:0.5rem;border:1px solid #d1d5db;border-radius:0.5rem;font-size:0.75rem;">{lang === 'it' ? 'Preferenze cookie' : 'Cookie preferences'}</button>

<!-- Settings Modal -->
<div id="cookie-modal" class="cookie-modal hidden">
  <div class="cookie-modal-content">
    <div class="cookie-modal-header">
      <h3>{lang === 'it' ? 'Impostazioni Cookie' : 'Cookie Settings'}</h3>
      <button id="cookie-modal-close" class="close-btn">&times;</button>
    </div>
    <div class="cookie-modal-body">
      <div class="cookie-category">
        <div class="cookie-category-header">
          <label class="cookie-label">
            <input type="checkbox" checked disabled />
            <span class="cookie-category-title">{lang === 'it' ? 'Cookie Tecnici (Necessari)' : 'Technical Cookies (Necessary)'}</span>
          </label>
        </div>
        <p class="cookie-category-desc">
          {lang === 'it' 
            ? 'Cookie essenziali per il funzionamento del sito. Non possono essere disabilitati.' 
            : 'Essential cookies for site functionality. Cannot be disabled.'}
        </p>
      </div>

      <div class="cookie-category">
        <div class="cookie-category-header">
          <label class="cookie-label">
            <input type="checkbox" id="cookie-analytics" />
            <span class="cookie-category-title">{lang === 'it' ? 'Cookie Analytics' : 'Analytics Cookies'}</span>
          </label>
        </div>
        <p class="cookie-category-desc">
          {lang === 'it' 
            ? 'Utilizzati per analisi statistiche e miglioramento delle performance.' 
            : 'Used for statistical analysis and performance improvement.'}
        </p>
      </div>
    </div>
    <div class="cookie-modal-footer">
      <button id="cookie-save" class="btn-primary">{lang === 'it' ? 'Salva Preferenze' : 'Save Preferences'}</button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    border-top: 2px solid #e5e7eb;
    padding: 1.5rem;
    box-shadow: 0 -4px 6px -1px rgba(0, 0, 0, 0.1);
    z-index: 9999;
    animation: slideUp 0.3s ease-out;
  }

  @keyframes slideUp {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  .cookie-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .cookie-text {
    flex: 1;
  }

  .cookie-text p {
    margin: 0;
    color: #374151;
    line-height: 1.6;
  }

  .cookie-link {
    color: #2563eb;
    text-decoration: underline;
    font-weight: 600;
  }

  .cookie-link:hover {
    color: #1d4ed8;
  }

  .cookie-actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .btn-primary, .btn-secondary {
    padding: 0.625rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
    font-size: 0.875rem;
  }

  .btn-primary {
    background: #2563eb;
    color: white;
  }

  .btn-primary:hover {
    background: #1d4ed8;
  }

  .btn-secondary {
    background: white;
    color: #374151;
    border: 1px solid #d1d5db;
  }

  .btn-secondary:hover {
    background: #f9fafb;
  }

  .hidden {
    display: none !important;
  }

  /* Modal Styles */
  .cookie-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .cookie-modal-content {
    background: white;
    border-radius: 1rem;
    max-width: 600px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
  }

  .cookie-modal-header {
    padding: 1.5rem;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cookie-modal-header h3 {
    margin: 0;
    font-size: 1.25rem;
    color: #111827;
  }

  .close-btn {
    background: none;
    border: none;
    font-size: 2rem;
    color: #6b7280;
    cursor: pointer;
    line-height: 1;
    padding: 0;
    width: 2rem;
    height: 2rem;
  }

  .close-btn:hover {
    color: #111827;
  }

  .cookie-modal-body {
    padding: 1.5rem;
  }

  .cookie-category {
    margin-bottom: 1.5rem;
  }

  .cookie-category:last-child {
    margin-bottom: 0;
  }

  .cookie-category-header {
    margin-bottom: 0.5rem;
  }

  .cookie-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
  }

  .cookie-label input[type="checkbox"] {
    width: 1.25rem;
    height: 1.25rem;
    cursor: pointer;
  }

  .cookie-label input[type="checkbox"]:disabled {
    cursor: not-allowed;
  }

  .cookie-category-title {
    font-weight: 600;
    color: #111827;
    font-size: 1rem;
  }

  .cookie-category-desc {
    margin: 0;
    color: #6b7280;
    font-size: 0.875rem;
    padding-left: 2rem;
  }

  .cookie-modal-footer {
    padding: 1.5rem;
    border-top: 1px solid #e5e7eb;
    display: flex;
    justify-content: flex-end;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .cookie-content {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    .cookie-actions {
      flex-direction: column;
    }

    .btn-primary, .btn-secondary {
      width: 100%;
    }
  }
</style>

<script>
  // Check if user has already made a choice
  const consentKey = 'ga4ConsentV1';
  const cookieConsent = localStorage.getItem(consentKey);
  const banner = document.getElementById('cookie-banner');
  const modal = document.getElementById('cookie-modal');
  const measurementId = 'G-RR472M1V04';
  const analyticsWindow = window as unknown as Window & { dataLayer?: unknown[]; gtag?: (...args: unknown[]) => void; [key: `ga-disable-${string}`]: boolean };
  document.getElementById('cookie-reopen')?.addEventListener('click', () => {
    banner?.classList.remove('hidden');
  });

  if (!cookieConsent && banner) {
    banner.classList.remove('hidden');
  }

  // Accept all cookies
  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    localStorage.setItem('cookieConsent', 'all');
    localStorage.setItem('analyticsEnabled', 'true');
    localStorage.setItem(consentKey, 'granted');
    banner?.classList.add('hidden');
    enableAnalytics();
  });

  // Decline all non-essential cookies
  document.getElementById('cookie-decline')?.addEventListener('click', () => {
    localStorage.setItem('cookieConsent', 'essential');
    localStorage.setItem('analyticsEnabled', 'false');
    localStorage.setItem(consentKey, 'denied');
    banner?.classList.add('hidden');
    disableAnalytics();
  });

  // Open settings modal
  document.getElementById('cookie-settings')?.addEventListener('click', () => {
    modal?.classList.remove('hidden');
    // Load current analytics preference
    const analyticsEnabled = localStorage.getItem(consentKey) === 'granted';
    const analyticsCheckbox = document.getElementById('cookie-analytics') as HTMLInputElement;
    if (analyticsCheckbox) {
      analyticsCheckbox.checked = analyticsEnabled;
    }
  });

  // Close modal
  document.getElementById('cookie-modal-close')?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  // Close modal on backdrop click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  // Save preferences
  document.getElementById('cookie-save')?.addEventListener('click', () => {
    const analyticsCheckbox = document.getElementById('cookie-analytics') as HTMLInputElement;
    const analyticsEnabled = analyticsCheckbox?.checked || false;
    
    localStorage.setItem('cookieConsent', 'custom');
    localStorage.setItem('analyticsEnabled', analyticsEnabled.toString());
    localStorage.setItem(consentKey, analyticsEnabled ? 'granted' : 'denied');
    
    if (analyticsEnabled) {
      enableAnalytics();
    } else {
      disableAnalytics();
    }
    
    banner?.classList.add('hidden');
    modal?.classList.add('hidden');
  });

  function enableAnalytics() {
    analyticsWindow[`ga-disable-${measurementId}`] = false;
    if (document.getElementById('ga4-tag')) {
      window.location.reload();
      return;
    }
    analyticsWindow.dataLayer = [];
    analyticsWindow.gtag = function () { analyticsWindow.dataLayer!.push(arguments); };
    analyticsWindow.gtag('consent', 'default', { analytics_storage: 'granted', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
    analyticsWindow.gtag('js', new Date());
    analyticsWindow.gtag('config', measurementId, {
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
      page_location: window.location.origin + window.location.pathname,
      page_referrer: document.referrer.split('?')[0].split('#')[0],
    });
    const script = document.createElement('script');
    script.id = 'ga4-tag';
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
    document.head.append(script);
  }

  function disableAnalytics() {
    analyticsWindow[`ga-disable-${measurementId}`] = true;
    for (const cookie of document.cookie.split(';')) {
      const name = cookie.split('=')[0].trim();
      if (name !== '_ga' && !name.startsWith('_ga_')) continue;
      for (const domain of ['', window.location.hostname, '.' + window.location.hostname]) {
        document.cookie = `${name}=; Max-Age=0; path=/;${domain ? ` domain=${domain};` : ''}`;
      }
    }
    if (document.getElementById('ga4-tag')) window.location.reload();
  }

  // Initialize analytics if user has already consented
  if (cookieConsent === 'granted') {
    enableAnalytics();
  }
</script>
