---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import BlogCard from './BlogCard.astro';
import BlogSectionNav from './BlogSectionNav.astro';
import BlogFilters from './BlogFilters.astro';
import BlogNextSteps from './BlogNextSteps.astro';
import { type BlogPost, type Language } from '../lib/blog';
import { sectionIds, sectionLabels, sectionUrl, metadataFor, formatLabels, levelLabels, readingMinutes, relatedPosts, topicLabels, type SectionId } from '../lib/blog-editorial';

interface Props { lang: Language; posts?: BlogPost[]; post?: BlogPost; allPosts?: BlogPost[]; sectionId?: SectionId; archive?: boolean }
const { lang, posts = [], post, allPosts = [], sectionId, archive = false } = Astro.props;
const en = lang === 'en';
const base = en ? '/en' : '';
const hubTitle = en ? 'Research, methods and applications' : 'Ricerca, metodi e applicazioni';
const description = post ? post.summary[lang] : en
  ? 'Explore research, technical methods and practical applications, with sources and clear limitations.'
  : 'Esplora ricerca, metodi tecnici e applicazioni pratiche, con fonti e limiti espliciti.';
const title = post ? post.title[lang] : sectionId ? sectionLabels[sectionId][lang] : archive ? sectionLabels.archive[lang] : hubTitle;
const meta = post ? metadataFor(post.slug) : null;
const related = post ? relatedPosts(post, allPosts) : [];
const sectionPosts = sectionId ? posts.filter(item => metadataFor(item.slug)?.section === sectionId) : posts;
const formatDate = (value: string) => new Intl.DateTimeFormat(en ? 'en-GB' : 'it-IT', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${value}T00:00:00Z`));
const schema = post ? {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title[lang],
  description: post.summary[lang], datePublished: post.publishedAt, dateModified: post.updatedAt,
  inLanguage: lang, citation: post.sources.map(source => source.url),
  author: { '@type': 'Organization', name: 'Leone Consulting' },
  mainEntityOfPage: `https://leoneconsulting.dev${base}/blog/${post.slug}`,
} : undefined;
---
<Layout title={title} description={description} ogType={post ? 'article' : 'website'} noindex={!post && (sectionId ? sectionPosts.length === 0 : posts.length === 0)} schema={schema}>
  <Header />
  <main class="pt-32 pb-20 px-6">
    <div class="container mx-auto max-w-5xl">
      {post ? (
        <article>
          <nav aria-label={en ? 'Breadcrumb' : 'Percorso'} class="text-sm text-gray-600 flex flex-wrap gap-2">
            <a href={`${base}/blog`} class="text-primary-700 underline underline-offset-4">Blog</a><span aria-hidden="true">/</span>
            <a href={sectionUrl(meta?.section ?? 'archive', lang)} class="text-primary-700 underline underline-offset-4">{sectionLabels[meta?.section ?? 'archive'][lang]}</a><span aria-hidden="true">/</span><span aria-current="page">{post.title[lang]}</span>
          </nav>
          <header class="mt-8 mb-10 max-w-3xl">
            <p class="text-sm font-semibold text-primary-700 mb-4">{post.topic[lang]}</p>
            {meta && <p class="text-sm text-gray-600 mb-4">{meta.topics.map(id => topicLabels[id][lang]).join(' · ')}</p>}
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-6">{post.title[lang]}</h1>
            <p class="text-xl text-gray-600 leading-relaxed mb-6">{post.summary[lang]}</p>
            <p class="text-sm text-gray-600 mb-5">{meta && <>{formatLabels[meta.format][lang]} · {levelLabels[meta.level][lang]} · </>}{readingMinutes(post, lang)} {en ? 'min read' : 'min di lettura'}</p>
            <dl class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-gray-600">
              <div><dt class="font-semibold">{en ? 'Published' : 'Pubblicato'}</dt><dd><time datetime={post.publishedAt!}>{formatDate(post.publishedAt!)}</time></dd></div>
              <div><dt class="font-semibold">{en ? 'Updated' : 'Aggiornato'}</dt><dd><time datetime={post.updatedAt}>{formatDate(post.updatedAt)}</time></dd></div>
              {post.eventDate && <div><dt class="font-semibold">{en ? 'Event date' : 'Data della novità'}</dt><dd><time datetime={post.eventDate}>{formatDate(post.eventDate)}</time></dd></div>}
            </dl>
          </header>
          <nav aria-label={en ? 'Article contents' : 'Indice dell’articolo'} class="max-w-3xl mb-10 rounded-xl border border-gray-200 p-6">
            <h2 class="font-bold text-gray-900 mb-3">{en ? 'Contents' : 'Indice'}</h2>
            <ol class="list-decimal pl-5 space-y-2">{post.sections.map((section, index) => <li><a class="text-primary-700 underline underline-offset-4" href={`#section-${index}`}>{section.heading[lang]}</a></li>)}<li><a class="text-primary-700 underline underline-offset-4" href="#sources-title">{en ? 'Sources and verification' : 'Fonti e verifica'}</a></li></ol>
          </nav>
          <div class="max-w-3xl space-y-10">
            {post.sections.map((section, index) => (
              <section aria-labelledby={`section-${index}`}>
                <p class="text-xs font-semibold uppercase tracking-wide text-primary-700 mb-2">{section.kind === 'fact' ? (en ? 'From the sources' : 'Dalle fonti') : (en ? 'Our analysis' : 'La nostra analisi')}</p>
                <h2 id={`section-${index}`} class="scroll-mt-28 text-2xl font-bold text-gray-900 mb-4">{section.heading[lang]}</h2>
                <div class="space-y-4 text-lg text-gray-700 leading-relaxed">{section.paragraphs[lang].map(paragraph => <p>{paragraph}</p>)}</div>
                <p class="mt-4 text-sm text-gray-600">{en ? 'Sources: ' : 'Fonti: '}{section.sourceIds.map(id => <a href={`#source-${id}`} class="inline-block mr-3 text-primary-700 underline underline-offset-4">{post.sources.find(source => source.id === id)?.publisher} [{post.sources.findIndex(source => source.id === id) + 1}]</a>)}</p>
              </section>
            ))}
          </div>
          <aside aria-labelledby="sources-title" class="mt-12 max-w-3xl rounded-xl bg-gray-50 border border-gray-200 p-6">
            <h2 id="sources-title" class="scroll-mt-28 text-2xl font-bold text-gray-900 mb-6">{en ? 'Sources and verification' : 'Fonti e verifica'}</h2>
            <ol class="space-y-5 list-decimal pl-5">{post.sources.map(source => (
              <li id={`source-${source.id}`} class="scroll-mt-28 pl-1">
                <a href={source.url} rel="noopener noreferrer" class="text-primary-700 underline underline-offset-4 font-semibold">{source.title}</a>
                <p class="text-sm text-gray-600 mt-1">{source.publisher} · {en ? 'Source date' : 'Data della fonte'}: {source.publishedAt ? formatDate(source.publishedAt) : (en ? 'Not specified' : 'Non indicata')} · {en ? 'Checked' : 'Verificata'}: {formatDate(source.checkedAt)}</p>
              </li>
            ))}</ol>
          </aside>
          {related.length > 0 && <section aria-labelledby="related-posts" class="mt-12 max-w-3xl"><h2 id="related-posts" class="text-2xl font-bold text-gray-900 mb-5">{en ? 'Related articles' : 'Articoli correlati'}</h2><ul class="space-y-3">{related.map(item => <li><a href={`${base}/blog/${item.slug}`} class="text-primary-700 font-semibold underline underline-offset-4">{item.title[lang]}</a><span class="text-sm text-gray-500"> · {item.topic[lang]}</span></li>)}</ul></section>}
        </article>
      ) : (
        <>
          {(sectionId || archive) && <a href={`${base}/blog`} class="text-primary-700 font-semibold underline underline-offset-4">← {en ? 'Blog home' : 'Home del blog'}</a>}
          <header class:list={['max-w-3xl mb-10', { 'mt-8': sectionId || archive }]}>
            <p class="text-primary-700 font-semibold mb-4">Blog · Leone Consulting</p>
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-6">{title}</h1>
            <p class="text-xl text-gray-600 leading-relaxed">{description}</p>
          </header>
          <BlogSectionNav lang={lang} active={sectionId ?? (archive ? 'archive' : undefined)} />
          {sectionId || archive ? (
            sectionPosts.length ? <BlogFilters posts={sectionPosts} lang={lang} /> : <p class="rounded-xl bg-gray-50 border border-gray-200 p-8 text-gray-700">{en ? 'No published articles in this section yet.' : 'Non ci sono ancora articoli pubblicati in questa sezione.'}</p>
          ) : (
            <div class="space-y-14">
              {sectionIds.map(id => {
                const group = posts.filter(item => metadataFor(item.slug)?.section === id);
                return <section aria-labelledby={`group-${id}`}><div class="flex flex-wrap items-baseline justify-between gap-3 mb-5"><h2 id={`group-${id}`} class="text-2xl font-bold text-gray-900">{sectionLabels[id][lang]}</h2><a href={sectionUrl(id, lang)} class="text-primary-700 font-semibold underline underline-offset-4">{en ? 'Explore section' : 'Esplora la sezione'} →</a></div>{group.length ? <div class="grid md:grid-cols-2 gap-6">{group.slice(0, 2).map(item => <BlogCard post={item} lang={lang} />)}</div> : <p class="rounded-xl bg-gray-50 border border-gray-200 p-6 text-gray-700">{en ? 'No published articles in this section yet.' : 'Non ci sono ancora articoli pubblicati in questa sezione.'}</p>}</section>;
              })}
            </div>
          )}
        </>
      )}
      <BlogNextSteps lang={lang} article={!!post} section={meta?.section} />
    </div>
  </main>
  <Footer />
</Layout>
